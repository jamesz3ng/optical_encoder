// Time variables
unsigned long b = 0; // Reading the time for main loop to run for 15.5s
unsigned long c = 0; // Memory for the time in main loop
unsigned long t0 = 0; // Memory of time for displaying the results

// Built-in encoder variables
float s = 0;   // Built-in encoder counts
float s_2 = 0; // Built-in encoder counts for PI controller
float rpmm = 0; // RPM obtained each 100ms from built-in encoder

int s1 = 0;    // Built-in encoder channel one output
int s2 = 0;    // Built-in encoder channel two output
int r = 0;     // Repetition indicator for reading counts of built-in encoder
int s2m = 0;   // Memory of built-in encoder channel two output
int directionm = 0;  // Indicator for direction read by built-in encoder
int dirm = 0;        // Indicator for direction read by built-in encoder
int RPM;             // Commanded RPM

int exitt = 0;       // Main loop exit condition

// Optical encoder variables
int s_optical = 0;     // Counts for RPM display every 5s
int s_optical_2 = 0;   // Counts for RPM calculation for PI controller
const int CPR_optical = 228; // Counts per revolution for optical encoder

const int encoderPinA = A0; // Channel A connected to analog pin A0
const int encoderPinB = A1; // Channel B connected to analog pin A1

volatile int encoderPos = 0;  // Position of the encoder
volatile bool direction = true; // true = CW, false = CCW

// Threshold voltages based on expected sensor readings
const float thresholdVoltageA = 1.0; // Adjust based on calibration
const float thresholdVoltageB = 1.0;

// Variables to store previous boolean states
bool prevAState = false;
bool prevBState = false;

// RPM variables
float rpmm_optical = 0;  // RPM obtained each 100ms from optical encoder
float rpm_optical = 0;   // RPM obtained each 5s from optical encoder

// PI controller variables
float ctrl = 0;      // PI controller output
float kp = 0.4;      // Proportional gain of PI controller 
float ki = 0.01;     // Integral gain of PI controller
float eri = 0;       // Integral of error of PI controller

int repc = 1;        // Repetition condition of PI controller
int repeat = 0;      // Repeat indicator for updating t0

float analogToDigital(int state) {
  float volts = state * (5.0 / 1023.0);
  return volts;
}

void setup() {
  Serial.begin(250000); // Baud rate of communication

  // Initial analog readings for channels A and B
  int initialA = analogRead(encoderPinA);
  float initialAVoltage = analogToDigital(initialA);
  prevAState = (initialAVoltage > thresholdVoltageA);

  int initialB = analogRead(encoderPinB);
  float initialBVoltage = analogToDigital(initialB);
  prevBState = (initialBVoltage > thresholdVoltageB);

  Serial.println("Enter the desired RPM.");

  while (Serial.available() == 0) {
    // Wait for user input
  }

  RPM = Serial.readString().toFloat(); // Reading the input string from Serial port
  if (RPM < 0) {
    analogWrite(3, 255); // Changing the direction of motor's rotation
  }
  RPM = abs(RPM);
}

void loop() {
  b = millis(); // Update current time

  while ((b >= c) && (b <= (c + 15500)) && exitt == 0) {
    // Read the analog voltage from both channels
    int stateA = analogRead(encoderPinA);
    float stateAVoltage = analogToDigital(stateA);
    int stateB = analogRead(encoderPinB);
    float stateBVoltage = analogToDigital(stateB);

    // Convert analog voltages to digital signals
    bool aState = (stateAVoltage > thresholdVoltageA);
    bool bState = (stateBVoltage > thresholdVoltageB);

    // Combine the two states into a 2-bit number
    int currentState = (aState << 1) | bState;
    int prevState = (prevAState << 1) | prevBState;

    // Determine the movement based on state transitions
    int movement = 0;
    if (currentState != prevState) {
      int index = (prevState << 2) | currentState;
      switch (index) {
        case 0b0001:
        case 0b0111:
        case 0b1110:
        case 0b1000:
          movement = 1; // Clockwise
          direction = true;
          break;
        case 0b0010:
        case 0b0100:
        case 0b1101:
        case 0b1011:
          movement = -1; // Counter-clockwise
          direction = false;
          break;
        default:
          // No valid movement detected (possible noise)
          movement = 0;
          break;
      }
      encoderPos += movement;

      // Increment optical encoder counts (consider direction)
      s_optical += movement;     // Counts for RPM display every 5s
      s_optical_2 += movement;   // Counts for RPM calculation for PI controller
    }

    // Update previous states
    prevAState = aState;
    prevBState = bState;

    // --- Begin Required Logic ---
    // PI controller
    if (b % 13 == 0 && repc == 1) {
      eri = ki * (RPM - rpmm) + eri;
      ctrl = 50 + kp * (RPM - rpmm) + eri;
      analogWrite(6, ctrl);
      repc = 0;
    }
    if (b % 13 == 1) {
      repc = 1;
    }

    // Built-in encoder reading
    s1 = digitalRead(7); // Reading Channel 1 of built-in encoder
    s2 = digitalRead(8); // Reading Channel 2 of built-in encoder
    if (s1 != s2 && r == 0) {
      s = s + 1;   // Counters for RPM displayed every 5s
      s_2 = s_2 + 1; // Counters for RPM used in PI controller
      r = 1;       // Indicator to prevent multiple counts
    }
    if (s1 == s2 && r == 1) {
      s = s + 1;
      s_2 = s_2 + 1;
      r = 0;
    }

    b = millis(); // Updating time
    if (b % 100 <= 1 && repeat == 0) {
      t0 = b; // Storing the current time once
      repeat = 1;
    }
    if (b % 100 > 1) {
      repeat = 0;
    }

    if (b % 100 == 0) {
      Serial.print("time in ms: ");
      Serial.print(b - t0);

      Serial.print("  spontaneous speed from built-in encoder:  ");
      rpmm = (s_2 / (2 * 114)) * 600; // RPM calculation every 100ms for PI controller
      Serial.println(rpmm);
      s_2 = 0; // Resetting the counters of PI controller RPM meter

      if ((b - t0) % 5000 == 0) {
        Serial.println();
        Serial.print("RPM from built-in encoder: ");
        Serial.println((s / (228)) * 12); // RPM over 5s

        Serial.print("RPM from optical quadrature encoder: ");
        // Calculate RPM from optical encoder over 5s
        rpm_optical = (s_optical / CPR_optical) * 12.0; // RPM over 5s
        Serial.println(rpm_optical);

        Serial.print("Error: ");
        Serial.println(rpm_optical - (s / (228)) * 12); // Error between optical and built-in encoders

        Serial.print("Direction read by motor's sensor: ");
        if (dirm == 0) {
          Serial.print("CW");
        } else {
          Serial.print("CCW");
        }
        Serial.print("  ,   ");

        Serial.print("Direction read by sensor:  ");
        if (direction) {
          Serial.println("CW");
        } else {
          Serial.println("CCW");
        }
        Serial.println();

        s = 0;
        s_optical = 0; // Resetting the optical encoder counter
        directionm = 0;
      }
      delay(1);
    }

    // Direction detection for built-in encoder
    if ((s1 == HIGH) && (s2 == HIGH) && (s2m == LOW)) {
      directionm = directionm + 1;
    }

    if ((s1 == LOW) && (s2 == LOW) && (s2m == HIGH)) {
      directionm = directionm + 1;
    }

    s2m = s2; // Memory of the previous built-in encoder channel 2

    if (directionm > 100) {
      dirm = 0;
    }
    if (directionm < 20) {
      dirm = 1;
    }

    b = millis(); // Updating time
    // --- End Required Logic ---

    delay(10); // Short delay for sensor stabilization
    b = millis(); // Update current time
  }

  analogWrite(6, 0); // Turning off the motor
  exitt = 1;         // Changing the exit condition to prevent the motor from running after 15s
  while (1) {
    // Stop the loop permanently
  }
}
