float analogToVoltage(float analogReading) {
  float volts = (analogReading) * (5.0 / 1023.0);
  return volts;
}

int updateBit(int pin, float threshold, bool previousBit, int i) {
  int voltage = analogToVoltage(analogRead(pin));             // Reads voltage
  bool currentState = (voltage > threshold);                  // Checks whether the voltage indicates black (1) or white (0)
  gray[4-i] = currentState;
  return currentState ^ previousBit;                          // Returns the XOR of the current state and previous bit, resulting in a change only if there is a state transisiton
}

void updateAngle() {
  for (int i = 0; i < 5; i++) {
    currentBits[4-i] = updateBit(A0 + i, voltageThreshold[4-i], previousBit, i);   // Update currently read bit
    previousBit = currentBits[4-i];                                           // Set current bit to previous bit for next iteration
  }

  decimalValue = 0;
  for (int i = 0; i < 5; i++) { if (currentBits[i]) { decimalValue += (1 << i); } }   // If 1, add the corresponding power of two
  
  current_angle = decimalValue * (360.0 / 32.0);                                          // Get the current angle position
}


