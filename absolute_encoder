  deg = Serial.readString().toFloat();                          // Reading the Input string from Serial port.
  if (deg<0) { analogWrite(3,255); }                            // Change the direction of rotation by applying voltage to pin 3 of arduino
  deg=abs(deg);                                                 // Convert to positive regardless of user inputed direction
}


