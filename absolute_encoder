float analogToVoltage(float analogReading) {
  volts = (analogReading) * (5.0 / 1023.0);
  return volts;
}

int updateBit(int pin, float threshold, bool previousBit, int i) {
  voltage = analogToVoltage(analogRead(pin));             // Reads voltage
  currentState = (voltage > threshold);                  // Checks whether the voltage indicates black (1) or white (0)
  gray[i] = currentState;
  if (i == 0) { return currentState; }
  else {return currentState ^ previousBit; }             // Returns the XOR of the current state and previous bit, resulting in a change only if there is a state transisiton
}

void updateAngle() {
  for (int i = 0; i < 5; i++) {
    currentBits[i] = updateBit(A0 + i, voltageThreshold[i], previousBit, i);    // Update currently read bit, A0 is MSB
    previousBit = currentBits[i];                                               // Set current bit to previous bit for next iteration
  }

  decimalValue = 0;
  for (int i = 0; i < 5; i++) { if (currentBits[i]) { decimalValue += (1 << (4-i)); } }   // If 1, add the corresponding power of two
  
  current_angle = decimalValue * (360.0 / 32.0);                                          // Get the current angle position
}

bool gray_equal(int *array1, int *array2) {
    for (int i = 0; i < 5; i++) { if (array1[i] != array2[i]) { return false; } }
    return true;
}

void MotorMovement () {
  t = millis();                                   // reading time
  t0 = t;                                         // saving the current time in memory
  while (t < t0 + 4000 && rep <= 10) {            // let the code to ran for 4 seconds each with repetitions of 10
    if (t % 10 == 0)  {                           // PI controller that runs every 10ms
      if (s < deg * encoder_conversion) {         // Check if encoder counts are less than target
        er = deg - s / encoder_conversion;        // Calculate proportional error
        eri = eri + er;                           // Update integral error
        analogWrite(6, kp * er + ki * eri); 	    // Write control signal to motor
      }

      if (s >= deg * encoder_conversion) {        // If the desired position is reached
        analogWrite(6, 0);                        // Stop the motor
        eri = 0;                                  // Reset integral
      }
      delay(1);                                   // Delay one millisecond
    }
    sm1 = digitalRead(7);                         // Read chanel 1
    sm2 = digitalRead(8);                         // Read chanel 2

    if (sm1 != sm2 && r == 0) { s += 1; r = 1; }  // Increment encoder count and set indicator to avoid counting again
    if (sm1 == sm2 && r == 1) { s += 1; r = 0; }  // Increment encoder count and reset indicator

    t = millis();                                 // Updating time
    finish = 1;                                   // Changing finish indicator
  }

  if (finish) {                              // This part of the code is for displaying the result
    delay(500);                                   // Half second delay
    rep += 1;                                     // Increasing the repetition indicator

    Serial.println("Shaft position from optical absolute sensor from home position: " + String(current_angle - home_angle));
    Serial.println("Shaft displacement from optical absolute sensor: " + String(current_angle - zero_angle));
    
    error = 0 - s / encoder_conversion;           // Calculate encoder
    Serial.println("Shaft displacement from motor's builtin encoder: " + String(abs(error)));
    Serial.println("Error: " + String(error) + "\n");
    
    s, finish = 0;                                // Reset encoder counts and finsh
    zero_angle = current_angle;                   // Set zero angle to the current angle 
  }
  analogWrite(6, 0);                              // Turning off the motor
}
